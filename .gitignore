# 依赖与构建产物
node_modules/
dist/
build/
.wrangler/
.cache/
.dev.vars.tmp

# 环境变量 / 密钥（含 Cloudflare API Token 与 PROXY_SECRET，绝不能提交）
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# 工具生成的集成规则与缓存，不进仓库（但自写的 skills 要提交）
.codebuddy/*
!.codebuddy/skills/
!.codebuddy/skills/**

# 部署账号与环境说明（本地文件，含账号信息）
.deploy/

# 文案保存前留的上一版备份
src/copy.json.bak

# 房间数据库与本地临时产物
.data/
.data-shots/
refs/

# 本地调试用的浏览器配置（CDP 启动的 Edge profile，体积很大）
.browser-profile/
